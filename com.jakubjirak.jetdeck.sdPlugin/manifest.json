{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "JetDeck",
	"Version": "1.2.0.0",
	"Author": "Jakub Jirák",
	"Description": "Live status and one-touch control of Claude Code, Codex and Copilot CLI sessions, plus live CPU, GPU, Neural Engine, RAM and disk usage.",
	"UUID": "com.jakubjirak.jetdeck",
	"Icon": "imgs/plugin/icon",
	"Category": "JetDeck",
	"CategoryIcon": "imgs/plugin/category",
	"CodePath": "bin/plugin.mjs",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "13"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"Actions": [
		{
			"Name": "Agent Session",
			"UUID": "com.jakubjirak.jetdeck.session",
			"Icon": "imgs/actions/session/icon",
			"Tooltip": "Live state of one Claude Code / Codex / Copilot CLI session. Press: jump to its terminal. Hold: approve the pending prompt, or interrupt the running turn.",
			"PropertyInspectorPath": "ui/session.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/session/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Needs You",
			"UUID": "com.jakubjirak.jetdeck.attention",
			"Icon": "imgs/actions/attention/icon",
			"Tooltip": "How many agent sessions are waiting for you. Press: jump to the longest-waiting one. Hold: approve it.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/attention/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Send Prompt",
			"UUID": "com.jakubjirak.jetdeck.prompt",
			"Icon": "imgs/actions/prompt/icon",
			"Tooltip": "Types a saved prompt into the best-matching agent session and jumps to it.",
			"PropertyInspectorPath": "ui/prompt.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/prompt/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "System Metric",
			"UUID": "com.jakubjirak.jetdeck.metric",
			"Icon": "imgs/actions/metric/icon",
			"Tooltip": "Live CPU, GPU, Neural Engine, RAM, disk or power usage with a 48-second history. Press: open Activity Monitor.",
			"PropertyInspectorPath": "ui/metric.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false,
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/metric/key",
					"ShowTitle": false
				}
			]
		}
	]
}
