{
  "name": "jetdeck",
  "version": "1.4.0",
  "private": true,
  "description": "Stream Deck plugin: live status and one-touch control of Claude Code, Codex and Copilot CLI sessions, plus live CPU, GPU, Neural Engine, RAM, disk and power of your Mac.",
  "keywords": [
    "stream-deck",
    "elgato",
    "claude-code",
    "codex",
    "copilot-cli",
    "ai-agents",
    "macos",
    "apple-silicon",
    "developer-tools"
  ],
  "homepage": "https://github.com/JirakJ/jetdeck#readme",
  "bugs": {
    "url": "https://github.com/JirakJ/jetdeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JirakJ/jetdeck.git"
  },
  "license": "MIT",
  "author": "Jakub Jirák <jirak92@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm test",
    "validate": "streamdeck validate com.jakubjirak.jetdeck.sdPlugin",
    "link": "streamdeck link com.jakubjirak.jetdeck.sdPlugin",
    "restart": "streamdeck restart com.jakubjirak.jetdeck",
    "pack": "streamdeck pack com.jakubjirak.jetdeck.sdPlugin --output dist --force",
    "hooks:install": "node scripts/hooks.mjs install",
    "hooks:uninstall": "node scripts/hooks.mjs uninstall",
    "status": "node scripts/status.mjs",
    "profile:install": "node scripts/profile.mjs",
    "power:enable": "sh scripts/power.sh enable",
    "power:disable": "sh scripts/power.sh disable",
    "power:status": "sh scripts/power.sh status",
    "docs:images": "node scripts/render-docs.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4",
    "@elgato/utils": "0.6.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@types/node": "^24.12.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
